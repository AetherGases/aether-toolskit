--CREATE TYPE
CREATE TYPE status_employee AS ENUM('active', 'on leave', 'on vacation', 'dismissed');

CREATE TYPE status_inventory AS ENUM('pending', 'in review', 'approved');

-------------
--REF
CREATE TABLE addresses ( 
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  street VARCHAR(255) NOT NULL,
  number VARCHAR(20) NOT NULL,
  complement VARCHAR(100),
  city VARCHAR(100) NOT NULL,
  state VARCHAR(100),
  country VARCHAR(100) NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  
);

CREATE TABLE companies (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  size INT CHECK (size > 0),
  registration_date DATE,
  tax_id VARCHAR(50),
  email VARCHAR(255) NOT NULL,
  address_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (address_id) REFERENCES addresses (id)
);

CREATE TABLE units (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  company_id INT,
  address_id INT,
  cnpj VARCHAR(50) NOT NULL,
  cnae VARCHAR(50) NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (company_id) REFERENCES companies (id),
  FOREIGN KEY (address_id) REFERENCES addresses (id)
);

CREATE TABLE telephone_companies (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  telephone VARCHAR(20) NOT NULL,
  company_id INT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  is_active BOOLEAN DEFAULT TRUE,
  FOREIGN KEY (company_id) REFERENCES companies (id)
);

CREATE TABLE sectors (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  description VARCHAR(255),
  unit_id INT,
  company_id INT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  is_active BOOLEAN DEFAULT TRUE,
  FOREIGN KEY (company_id) REFERENCES companies (id),
  FOREIGN KEY (unit_id) REFERENCES units (id)
);

CREATE TABLE permission_groups (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP 
);

CREATE TABLE administrators (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  email VARCHAR(255) NOT NULL,
  password VARCHAR(255) NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-------------
-- EMPLOYEE
CREATE TABLE employees (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  company_id INT,
  permission_group_id INT,
  unit_id INT,
  name VARCHAR(255) NOT NULL,
  email VARCHAR(255) NOT NULL,
  status status_employee NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (company_id) REFERENCES companies (id),
  FOREIGN KEY (permission_group_id) REFERENCES permission_groups (id),
  FOREIGN KEY (unit_id) REFERENCES units (id)
);

CREATE TABLE employee_telephones (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  telephone VARCHAR(20) NOT NULL,
  employee_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (employee_id) REFERENCES employees (id)
);

CREATE TABLE contracts (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  employee_id INT,
  company_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (employee_id) REFERENCES employees (id),
  FOREIGN KEY (company_id) REFERENCES companies (id)
);

----------------
--INVENTORY
CREATE TABLE inventories (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  company_id INT,
  employee_id INT,
  sector_id INT,
  file_size FLOAT CHECK (file_size > 0),
  status status_inventory DEFAULT 'pending',
  file_path VARCHAR(255),
  start_period DATE NOT NULL,
  end_period DATE NOT NULL CHECK (end_period > start_period),
  submission_date DATE,
  type VARCHAR(100),
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (company_id) REFERENCES companies (id),
  FOREIGN KEY (employee_id) REFERENCES employees (id),
  FOREIGN KEY (sector_id) REFERENCES sectors (id)
);

----------------------------
--SUBSCRIPTION / PAYMENT
CREATE TABLE plans (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  description VARCHAR(255) NOT NULL,
  price NUMERIC(12,2) NOT NULL CHECK (price > 0),
  currency VARCHAR(10) NOT NULL DEFAULT 'Reais',
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE subscriptions (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  company_id INT,
  plan_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  installments BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (company_id) REFERENCES companies (id),
  FOREIGN KEY (plan_id) REFERENCES plans (id)
);

CREATE TABLE payments (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  currency VARCHAR(10) not null,
  subscription_id INT,
  additional_use_value NUMERIC(12,2) CHECK (additional_use_value > 0),
  due_date DATE,
  payment_type VARCHAR(50),
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (subscription_id) REFERENCES subscriptions (id)
);

---------------
-- ROI
CREATE TABLE roi_analyses (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  inventory_id INT,
  calculation_date DATE,
  years_along INT,
  annual_operating_savings NUMERIC(12,2) CHECK (annual_operating_savings > 0),
  estimated_payback_month FLOAT,
  carbon_credit_revenue NUMERIC(12,2) CHECK (carbon_credit_revenue > 0),
  annual_rate_technology_degradation FLOAT,
  wacc FLOAT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, 
  FOREIGN KEY (inventory_id) REFERENCES inventories (id)
);

CREATE TABLE roi_projection_years (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  roi_analysis_id INT,
  year INT,
  value FLOAT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (roi_analysis_id) REFERENCES roi_analyses (id)
);

---------------
-- GAS
CREATE TABLE gases (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  type VARCHAR(100),
  measurement VARCHAR(50),
  gwp FLOAT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP 
);

CREATE TABLE sector_gases (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  sector_id INT,
  gas_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (sector_id) REFERENCES sectors (id),
  FOREIGN KEY (gas_id) REFERENCES gases (id)
);

CREATE TABLE gas_reductions (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  gas_id INT,
  unit VARCHAR(50),
  current_emission FLOAT,
  estimated_days INT,
  estimated_reduction FLOAT,
  estimated_roi NUMERIC(12,2) CHECK (estimated_roi > 0),
  init_emission FLOAT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (gas_id) REFERENCES gases (id)
);

CREATE TABLE reduction_gases (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  gas_reduction_id INT,
  gas_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (gas_reduction_id) REFERENCES gas_reductions (id),
  FOREIGN KEY (gas_id) REFERENCES gases (id)
);

CREATE TABLE gas_reduction_inventories (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  gas_reduction_id INT,
  inventory_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (gas_reduction_id) REFERENCES gas_reductions (id),
  FOREIGN KEY (inventory_id) REFERENCES inventories (id)
);

CREATE TABLE gas_reduction_sector (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  gas_reduction_id INT,
  sector_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (gas_reduction_id) REFERENCES gas_reductions (id),
  FOREIGN KEY (sector_id) REFERENCES sectors (id)
);

CREATE TABLE parana_climate_seals (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  date_achievement DATE,
  current_score FLOAT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
  
);

CREATE TABLE contains (
  id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  parana_climate_seal_id INT,
  company_id INT,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (parana_climate_seal_id) REFERENCES parana_climate_seals (id),
  FOREIGN KEY (company_id) REFERENCES companies (id)
);

