# PostgreSQL:
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=sa
POSTGRES_PASSWORD=DefaultPassword!0
POSTGRES_DB_FIRST_YEAR=dbAether1Year
POSTGRES_DB_SECOND_YEAR=dbAether2Year

# MongoDB:
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=mongo
MONGO_PASSWORD=DefaultPassword!0
MONGO_DB=dbAether
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# Redis:
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=DefaultPassword!0

