# Only variables defined in this file are sent to the Kubernetes Secret aether-env.
# AWS/EKS keys below are used locally by the toolskit and are not copied into the cluster.
# Databases run outside the cluster; fill hostnames from your provider (one Postgres with two DBs).

# PostgreSQL (managed; two databases on the same instance):
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_FIRST_YEAR=dbAether1Year
POSTGRES_DB_SECOND_YEAR=dbAether2Year

# MongoDB (managed). Leave MONGO_URI empty to build from host/port, or set a full Atlas SRV URI.
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=dbAether
MONGO_URI=

# Redis (managed):
REDIS_HOST=
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USER=
REDIS_PASSWORD=

# AWS / EKS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=sa-east-1
EKS_NODE_TYPE=t3.medium
EKS_NODE_COUNT=1
EKS_CLUSTER_ROLE_ARN=
EKS_NODE_ROLE_ARN=
JWT_SECRET=

# ms-aeko-hub (OAuth MCP; public URLs behind Kong /hub)
AUTH_MS_BASE_URL=http://aether-ms-auth:8080
OAUTH_ISSUER=https://aethergases.org/hub
OAUTH_AUDIENCE=https://aethergases.org/hub/aether-api/v1/mcp/
# JSON map of model name to USD per million tokens.
# Environment rates are more effective than hardcoded prices because they allow campaigns with custom pricing.
# python scripts/set_aeko_model_prices.py --path .env
AEKO_MODEL_PRICES='{"gemini-3.5-flash": {"input_per_million": 0.15, "output_per_million": 0.6}, "gemini-3.1-flash-lite": {"input_per_million": 0.025, "output_per_million": 0.15}}'
